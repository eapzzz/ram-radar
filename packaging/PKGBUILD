# Maintainer: Julian <https://github.com/eapzzz>
pkgname=still-monitor-git
pkgver=0.2.0.r0.g0000000
pkgrel=1
pkgdesc='A quiet, capable native Linux system monitor'
arch=('x86_64' 'aarch64')
url='https://github.com/eapzzz/still'
license=('MIT')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'git')
optdepends=('hicolor-icon-theme: desktop icons' 'hwdata: GPU model names')
provides=('still-monitor')
conflicts=('still-monitor')
source=('still::git+https://github.com/eapzzz/still.git')
sha256sums=('SKIP')
pkgver() {
  cd "$srcdir/still"
  printf '0.2.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}
prepare() { cd "$srcdir/still"; cargo fetch --locked; }
build() { cd "$srcdir/still"; cargo build --release --frozen; }
check() { cd "$srcdir/still"; cargo test --frozen; }
package() {
  cd "$srcdir/still"
  install -Dm755 target/release/still "$pkgdir/usr/bin/still"
  install -Dm644 still.desktop "$pkgdir/usr/share/applications/still.desktop"
  install -Dm644 assets/still.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/still.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
